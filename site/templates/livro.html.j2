  height: auto;
}
.livro-info { flex: 1; min-width: 280px; }
.livro-info .hero-eyebrow { margin-bottom: 12px; }
.livro-info h1 {
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: clamp(1.7rem, 3.4vw, 2.4rem);
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--navy);
  margin-bottom: 14px;
}
.livro-info .subtitulo {
  font-size: 1rem;
  color: var(--blue);
  font-weight: 600;
  margin-bottom: 16px;
}
.livro-info .sinopse {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--text);
  max-width: 62ch;
  margin-bottom: 22px;
  text-align: justify;
}
.livro-ficha {
  display: flex;
  flex-wrap: wrap;
  gap: 18px 32px;
  margin-bottom: 24px;
}
.ficha-item { text-align: left; }
.ficha-item .num {
