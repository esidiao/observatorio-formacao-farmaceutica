  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  color: var(--accent);
}
.compra-card h3 {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  color: var(--navy);
  margin: 0;
}
.compra-card p {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.55;
  margin: 0;
}
.compra-preco {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--navy);
  font-family: var(--font-serif);
}
.compra-preco small {
  font-size: 0.7rem;
  font-weight: 500;
  color: var(--text-muted);
  font-family: var(--font-sans, inherit);
}
.compra-card .btn { align-self: flex-start; margin-top: 4px; }

.motivos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}
.motivo-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 4px solid var(--gold, #B07D22);
  border-radius: 8px;
  padding: 14px 16px;
}
.motivo-card h4 {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 6px;
}
.motivo-card p {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}
</style>
{% endblock %}

{% block content %}

<div class="livro-hero">
  <div class="livro-capa">
    <img src="{{ depth }}static/img/livro-capa.webp" alt="Capa do livro Formação Farmacêutica no Brasil, de Dr. Edson Sidião de Souza Júnior — Ocabooks" width="480" height="480">
  </div>

  <div class="livro-info">
    <p class="hero-eyebrow">O livro por trás deste observatório</p>
    <h1>Formação Farmacêutica no Brasil</h1>
    <p class="subtitulo">
      O diagnóstico que originou os indicadores que você está explorando agora.
    </p>
    <p class="sinopse">
      Este Observatório nasceu da pesquisa reunida neste livro. A obra apresenta um
      diagnóstico abrangente do ensino farmacêutico nacional, compilando dados oficiais
      e indicadores inéditos das 27 unidades federativas — expansão do ensino a distância,
      disparidades regionais, qualidade curricular, cobertura assistencial e vinculação
      com o SUS. O argumento central: o desafio não está na quantidade de vagas, mas na
      sua distribuição equilibrada e na qualidade da formação. Inclui análises estaduais,
      comparações internacionais e propostas de direcionamento para instituições de ensino
      e órgãos reguladores.
    </p>

    <div class="livro-ficha">
      <div class="ficha-item"><span class="num">180</span><span class="leg">Páginas</span></div>
      <div class="ficha-item"><span class="num">27</span><span class="leg">Estados analisados</span></div>
      <div class="ficha-item"><span class="num">14×21</span><span class="leg">Formato (cm)</span></div>
      <div class="ficha-item"><span class="num">2025</span><span class="leg">Ocabooks</span></div>
    </div>

    <div class="hero-cta">
      <a class="btn" href="https://afluente.art/produtos/formacao-farmaceutica-no-brasil/" target="_blank" rel="noopener">Comprar agora — R$ 99,00</a>
