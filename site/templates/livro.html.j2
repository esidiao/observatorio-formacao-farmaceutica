  font-weight: 700;
  font-size: 1.3rem;
  color: var(--navy);
  display: block;
  line-height: 1;
}
.ficha-item .leg {
  font-size: 0.7rem;
  color: var(--text-muted);
  margin-top: 4px;
  display: block;
}

.compra-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
  margin-bottom: 36px;
}
.compra-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.compra-card.destaque {
  border-color: var(--accent);
  box-shadow: 0 6px 20px rgba(14,124,102,0.10);
}
.compra-loja {
